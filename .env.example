# Copiar a .env.local y completar. .env.local NO se sube a ningún lado.
# Después de editarlo, verificá todo con:  node --env-file=.env.local scripts/check-setup.mjs --mail

# ── Mercado Pago → https://www.mercadopago.com.ar/developers (tu aplicación → credenciales)
# Para probar: el Access Token de PRUEBA. Para vender de verdad: el de PRODUCCIÓN.
MP_ACCESS_TOKEN=
# Opcional pero recomendado en producción (Tus integraciones → Webhooks → clave secreta).
# Si la definís, el sitio rechaza avisos sin firma válida. Probalo antes con el simulador de Mercado Pago.
MP_WEBHOOK_SECRET=

# ── Pago por transferencia: secreto para firmar el link "Confirmar pago" que te llega por mail.
# Mínimo 32 caracteres, al azar, y SECRETO (quien lo tenga puede confirmar pagos). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_LINK_SECRET=

# ── URL pública del sitio, sin / final. En local: http://localhost:3000
# El aviso automático de pagos (webhook) y el regreso automático solo funcionan con https público.
SITE_URL=http://localhost:3000

# ── Supabase → Project Settings → API. La service role key es SECRETA: solo acá, nunca en el código ni en el chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mails (Resend → https://resend.com, gratis para arrancar)
RESEND_API_KEY=
# A dónde llega el aviso de cada venta y de cada pedido de arrepentimiento (tu mail).
# Con el remitente de prueba tiene que ser el MISMO mail con el que abriste la cuenta de Resend.
ORDER_NOTIFY_EMAIL=
# Opcional. Sin esto se usa onboarding@resend.dev (solo puede escribirte a vos) y el newsletter NO puede pedir confirmación por mail.
# Para escribirle a clientes: verificá un dominio en Resend y poné, por ejemplo:  BYSLF <hola@tudominio.com>
MAIL_FROM=

# ── SOLO PARA PROBAR EN TU COMPUTADORA (sacalas antes de publicar; en producción se ignoran o no corresponden)
# Pone este precio a los productos sin precio, para poder hacer una compra de prueba.
DEV_TEST_PRICE=
# true = muestra la tienda, el carrito y el checkout sin editar lib/site.ts.
NEXT_PUBLIC_LAUNCHED=
